# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# DERIV_APP_ID: Registered Deriv Application ID (sent via Deriv-App-ID header).
DERIV_APP_ID="34RXuPGgdUNCTWhsYjRcD"

# DERIV_API_TOKEN: Optional server-default Personal API Token stored ONLY on the backend.
DERIV_API_TOKEN=""

# ALLOW_REAL_TRADING: Must be explicitly set to "true" to permit real-account live execution.
# Defaults to false (demo-first safeguard).
ALLOW_REAL_TRADING="false"
